# Odoo Docker Environment Configuration
# Copy this file and rename to .env, then fill in your values.
# Never commit the actual .env file with real passwords to version control.

# PostgreSQL settings
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_strong_password

# Odoo admin master password (used to create/manage databases via web UI)
ODOO_MASTER_PASSWORD=change_me_admin_password

# Port to expose Odoo on the host
ODOO_PORT=8069
